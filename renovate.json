{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "forkProcessing": "enabled",
  "configMigration": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "on monday"
    ],
    "automerge": false
  },
  "pre-commit": {
    "enabled": true,
    "commitMessagePrefix": "pre-commit: ",
    "branchPrefix": "pre-commit-"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process custom dependencies in Rust",
      "managerFilePatterns": [
        "/.+\\.rs$/"
      ],
      "matchStrings": [
        "//\\srenovate: datasource=(?<datasource>\\S+)( versioning=(?<versioning>\\S+))?\n.*?= \"(?<depName>\\S+):(?<currentValue>.*)\";\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Process custom dependencies in Yaml",
      "managerFilePatterns": [
        "/.+\\.yaml$/",
        "/.+\\.yml$/"
      ],
      "matchStrings": [
        "#\\srenovate: datasource=(?<datasource>\\S+)( versioning=(?<versioning>\\S+))?\n.*?: (?<depName>\\S+):(?<currentValue>.*)\n",
        "#\\srenovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?: (?<currentValue>.*)\n",
        "#\\srenovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?=\\S+(?<currentValue>.*)\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "commitMessagePrefix": "build(deps): ",
      "matchPackageNames": [
        "/.*/"
      ]
    },
    {
      "description": "Automerge non-breaking stable Rust dependencies after CI and a short release soak",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Automerge non-major GitHub Actions and pre-commit updates after CI",
      "matchManagers": [
        "github-actions",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Automerge tested patch updates of futures 0.x only; other pre-1.0 crates are reviewed",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "futures"
      ],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Never automerge controller-critical dependencies, even when their version looks stable",
      "matchPackageNames": [
        "kube",
        "kube-core",
        "kube-client",
        "kube-runtime",
        "kube-derive",
        "k8s-openapi",
        "kube-leader-election",
        "hcloud",
        "tower-http",
        "tikv-jemallocator",
        "hyper",
        "hyper-util",
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "opentelemetry-semantic-conventions",
        "tracing-opentelemetry",
        "tokio",
        "tokio-util",
        "tracing",
        "tracing-subscriber",
        "/^kube-/"
      ],
      "automerge": false
    },
    {
      "description": "Update kube-rs dependencies as one manually reviewed compatibility group",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "kube",
        "kube-leader-election",
        "k8s-openapi"
      ],
      "groupName": "kubernetes-client",
      "groupSlug": "kubernetes-client",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "/opentelemetry/",
        "tracing-opentelemetry"
      ],
      "groupName": "opentelemetry",
      "groupSlug": "opentelemetry"
    },
    {
      "matchPackageNames": [
        "renovatebot/pre-commit-hooks"
      ],
      "schedule": [
        "after 4am and before 10am on the first day of the month"
      ],
      "enabled": true,
      "description": "Keep pre-commit-hooks updates monthly; major versions remain manual"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "versioning": "loose",
      "matchPackageNames": [
        "/debian/"
      ]
    }
  ],
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "ignoreTests": false,
  "dependencyDashboard": true
}
